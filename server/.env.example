# Server port
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/skillbridge
# Atlas:      mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillbridge
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# JWT auth (use a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin (for CORS during development)
CLIENT_URL=http://localhost:5173
